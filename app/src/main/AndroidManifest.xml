<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.ToDoShift"
        android:label="ToDo Shift"
        android:supportsRtl="true"
        android:roundIcon="@mipmap/ic_launcher_round">


        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.attachments" android:exported="false" android:grantUriPermissions="true"><meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/neo_attachment_paths" /></provider>
        <activity android:name=".QuickTaskActivity" android:taskAffinity="com.todoshift.app.quicktask" android:exported="true" android:excludeFromRecents="true" android:theme="@style/Theme.ToDoShift.QuickTask" />
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true"
            android:theme="@style/Theme.ToDoShift.Splash">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/neo_shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    
        <service
            android:name=".v11.NeoEffectsJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <service
            android:name=".widget.CalendarWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />


        <receiver
            android:name=".reminders.ToDoShiftReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminders.ToDoShiftBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.ToDoShiftWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_shift_widget_info" />
        </receiver>

        <service
            android:name=".widget.TasksWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <receiver
            android:name=".widget.TasksWidgetProvider"
            android:label="@string/tasks_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasks_widget_info" />
        </receiver>

        <receiver android:name=".widget.Neo4TodayWidget" android:exported="true" android:label="@string/neo4_today_widget_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/neo4_today_widget_info" />
        </receiver>
        <receiver android:name=".widget.Neo4FinanceWidget" android:exported="true" android:label="@string/neo4_finance_widget_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/neo4_finance_widget_info" />
        </receiver>
    </application>
</manifest>
