<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/task_widget_check"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:gravity="center"
        android:text="@string/widget_complete_glyph"
        android:textSize="26sp"
        android:textColor="#326732" />

    <LinearLayout
        android:id="@+id/task_widget_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/task_widget_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#172033"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/task_widget_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#64748B"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
